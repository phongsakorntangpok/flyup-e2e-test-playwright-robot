# ใช้ร่วมกันทั้ง playwright/ และ robot/  (คัดลอกเป็น .env แล้วแก้ค่า)
BASE_URL=https://www.fly-up.app
PIONEER_EMAIL=your-pioneer@example.com
PIONEER_PASSWORD=your-password
# ไม่ต้องตั้งก็ได้ ระบบจะหา URL ของ backend เองจาก request ที่แอปยิงตอน login
API_BASE_URL=
# false = เปิดหน้าต่าง browser ให้เห็นตอนรัน
HEADLESS=true
